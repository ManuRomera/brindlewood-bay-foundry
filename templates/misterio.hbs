<section class="bb-caso">
  <header class="bb-cabecera bb-cabecera-caso">
    <button type="button" class="bb-retrato-boton" data-action="image" data-bb-info-title="Imagen del misterio" data-bb-info="Cambia la imagen y encuadra la zona que identifica este caso."><img class="bb-retrato" data-retrato="{{actor.id}}" src="{{actor.img}}" alt="Imagen de {{cleanName}}"><span><i class="fa-solid fa-crop-simple" aria-hidden="true"></i> Encuadrar</span></button>
    <div class="bb-identidad">
      <span class="bb-eyebrow">El tablero de la investigación{{#if system.voidMystery}} · Misterio del Vacío{{/if}}</span>
      {{#if gm}}<input class="bb-nombre" name="name" aria-label="Título del misterio" value="{{cleanName}}">{{else}}<h1 class="bb-nombre">{{cleanName}}</h1>{{/if}}
      <p class="bb-datos"><span>Complejidad <b>{{system.complexity}}</b></span><span><b>{{regular}}</b> pistas</span><span><b>{{voidClues}}</b> del Vacío</span><span class="bb-estado{{#if resolved}} resuelto{{/if}}">{{statusLabel}}</span></p>
    </div>
  </header>
  <div class="bb-barra">
    <button type="button" class="bb-primary" data-action="theorize"><i class="fa-solid fa-comments" aria-hidden="true"></i> Reunirnos para Teorizar</button>
    <button type="button" data-action="board" data-bb-info="Abre la pizarra de investigación: pistas, personas, notas y fotos sobre un corcho, unidas con hilos de colores. Es ambientación: no cambia ninguna regla."><i class="fa-solid fa-thumbtack" aria-hidden="true"></i> Pizarra</button>
    {{#if gm}}
      <button type="button" data-action="reveal"><i class="fa-solid fa-eye" aria-hidden="true"></i> Revelar al grupo</button>
      <button type="button" data-action="dossier"><i class="fa-solid fa-book-skull" aria-hidden="true"></i> Expediente</button>
      <button type="button" data-action="status">{{#if resolved}}Reabrir el caso{{else}}Marcar como resuelto{{/if}}</button>
    {{/if}}
  </div>
  <div class="bb-scroll">
    <div class="bb-columnas">
      <main>
        <div class="bb-titulo"><h2>Lo que sabemos</h2><span>{{system.clues.length}} pistas</span></div>
        {{#if system.description}}<p class="bb-presentacion">{{system.description}}</p>{{/if}}
        <div class="bb-pistas">{{#each clues}}<article class="bb-pista{{#if void}} vacio{{/if}}">
          <div class="bb-pista-cab"><span class="bb-etiqueta">{{#if void}}Pista del Vacío{{else}}Pista{{/if}}</span>{{#if ../gm}}<button type="button" class="bb-icono" data-action="editClueContext" data-id="{{id}}" aria-label="Editar contexto de la Guardiana" data-bb-info="Añade un matiz público a la pista sin cambiar su texto original."><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{/if}}</div>
          <p class="bb-pista-texto">{{text}}</p>
          {{#if context}}<p class="bb-contexto"><b>Contexto:</b> {{context}}</p>{{/if}}
          <details data-memoria="nota-{{id}}" {{#if hasNotes}}open{{/if}}><summary>Notas de investigación{{#if hasNotes}} ·{{/if}}</summary><textarea class="bb-nota-campo" data-case-note="clue" data-id="{{id}}" rows="3" aria-label="Notas sobre esta pista" placeholder="Hipótesis, relaciones, preguntas…" {{#unless ../canAnnotate}}readonly{{/unless}}>{{notes}}</textarea></details>
        </article>{{else}}<p class="bb-vacio">Una taza de té. Un detalle fuera de lugar.<br>La primera pista está por descubrir.</p>{{/each}}</div>

        <details class="bb-cuaderno" data-memoria="cuaderno" open>
          <summary>Cuaderno de investigación</summary>
          <p class="bb-tenue">Espacio compartido para conexiones, cronología e ideas provisionales. No altera las pistas ni fija una solución.</p>
          <textarea class="bb-nota-campo" data-case-note="case" rows="8" aria-label="Cuaderno de investigación del caso" placeholder="Id tejiendo aquí vuestra teoría…" {{#unless canAnnotate}}readonly{{/unless}}>{{system.notes}}</textarea>
        </details>
      </main>
      <aside>
        <div class="bb-titulo"><h2>Personas de interés</h2><span>{{system.suspects.length}} / {{limits.suspectsMax}}</span></div>
        {{#if gm}}<p class="bb-arrastra"><i class="fa-solid fa-hand-pointer" aria-hidden="true"></i> Arrastra aquí una ficha de Persona de interés para añadirla.</p>{{/if}}
        <div class="bb-sospechosos">{{#each suspects}}<article class="bb-sospechoso">
          <img class="bb-sospechoso-img" src="{{img}}" alt="Retrato de {{name}}">
          <div class="bb-sospechoso-cuerpo">
            <div class="bb-sospechoso-cab"><h3>{{name}}</h3>{{#if ../gm}}<span class="bb-iconos"><button type="button" class="bb-icono" data-action="editSuspect" data-index="{{index}}" aria-label="Editar presentación de {{name}}" data-bb-info="Editar lo que el grupo conoce de esta persona."><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{#if actorUuid}}<button type="button" class="bb-icono" data-action="openSuspect" data-uuid="{{actorUuid}}" aria-label="Abrir ficha de {{name}}" data-bb-info="Abrir la ficha original."><i class="fa-solid fa-address-card" aria-hidden="true"></i></button>{{/if}}<button type="button" class="bb-icono" data-action="removeSuspect" data-index="{{index}}" aria-label="Retirar a {{name}} del caso" data-bb-info="Retirar del tablero sin borrar la ficha."><i class="fa-solid fa-trash" aria-hidden="true"></i></button></span>{{/if}}</div>
            {{#if description}}<p>{{description}}</p>{{else}}<p class="bb-tenue">Sin presentación pública todavía.</p>{{/if}}
          </div>
          <details class="bb-sospechoso-notas" data-memoria="sosp-{{id}}" {{#if notes}}open{{/if}}><summary>Notas del grupo{{#if notes}} ·{{/if}}</summary><textarea class="bb-nota-campo" data-case-note="suspect" data-index="{{index}}" rows="3" aria-label="Notas sobre {{name}}" placeholder="Coartada, relaciones, contradicciones…" {{#unless ../canAnnotate}}readonly{{/unless}}>{{notes}}</textarea></details>
        </article>{{else}}<p class="bb-vacio">Aquí aparecerán las personas que la Guardiana presente al grupo.</p>{{/each}}</div>

        {{#if system.theory}}<details class="bb-teoria" data-memoria="teoria" open><summary>Nuestra teoría</summary><p>{{system.theory}}</p></details>{{/if}}
        <p class="bb-nota">No hay una solución predeterminada. Las pistas del Vacío hablan de la conspiración y no suman al Teorizar.</p>
        {{#if gm}}<details class="bb-ajustes" data-memoria="ajustes-caso"><summary>Ajustes de la Guardiana</summary>
          <label>Complejidad<select name="system.complexity">{{#each complexityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
          <p class="bb-tenue">{{complexityRule}} El manual pide al menos 20 pistas preparadas y no más de 12 sospechosos.</p>
          <label>Presentación pública<textarea name="system.description" rows="4">{{system.description}}</textarea></label>
        </details>{{/if}}
      </aside>
    </div>
  </div>
</section>
