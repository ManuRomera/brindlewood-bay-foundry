<section class="bb-experta">
  <header class="bb-masthead bb-expert-head">
    <button type="button" class="bb-portrait-button" data-action="image" data-bb-info-title="Retrato de {{actor.name}}" data-bb-info="Pulsa para elegir o subir una imagen. También se utilizará en su token enlazado."><img class="bb-portrait" src="{{actor.img}}" alt="Retrato de {{actor.name}}"><span><i class="fas fa-camera"></i> Cambiar</span></button>
    <div><span class="bb-eyebrow">EXPERTA DEL CRIMEN</span><input class="bb-name" name="name" aria-label="Nombre de la Experta" value="{{actor.name}}"><p>{{system.style}} · {{system.hobby}}</p></div>
    {{#if system.retired}}<div class="bb-retired">EXPERTA RETIRADA</div>{{/if}}
  </header>

  <div class="bb-stats">
    {{#each stats}}<div data-bb-info-title="{{label}}" data-bb-info="{{info}} Máximo permitido: +3."><label>{{label}}</label>{{#if ../unlocked}}<input type="number" min="-1" max="3" name="system.stats.{{key}}" value="{{value}}" aria-label="{{label}}">{{else}}<button type="button" data-action="roll" data-move="meddle" data-stat="{{key}}" aria-label="Investigar con {{label}}">{{value}}</button>{{/if}}</div>{{/each}}
  </div>

  <div class="bb-resource-strip" aria-label="Recursos importantes de la Experta">
    <div class="bb-resource-main"><b>{{system.xp}}</b><span>de {{limits.xp}} PE</span>{{#if system.xpPending}}<small>+{{system.xpPending}} pendiente</small>{{/if}}</div>
    <div><b>{{system.advances.length}}</b><span>de {{limits.advances}} avances</span></div>
    <div class="{{#if conditionFull}}alert{{/if}}"><b>{{system.conditions.length}}</b><span>de {{limits.conditions}} condiciones</span></div>
    <div><b>{{system.home.length}}</b><span>de {{limits.home}} hogar</span></div>
    <div><b>{{system.queen.length}}</b><span>de {{limits.queen}} Reina</span></div>
    <div><b>{{system.void}}</b><span>de {{limits.void}} Vacío</span></div>
    {{#if editable}}<button type="button" data-action="lock">{{#if unlocked}}Guardar habilidades{{else}}Editar habilidades{{/if}}</button>{{/if}}
  </div>

  <nav class="bb-tabs" aria-label="Secciones de la ficha">{{#each tabs}}<button type="button" data-action="switchTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}" aria-pressed="{{active}}">{{label}}</button>{{/each}}</nav>
  <div class="bb-scroll">
    {{#if play}}
      <div class="bb-two bb-play-layout">
        <main>
          <div class="bb-section-title"><h2>Haz un movimiento</h2><span>EL APUNTE ES OPCIONAL</span></div>
          <div class="bb-move-grid">{{#each moves}}<button type="button" class="bb-move" data-action="roll" data-move="{{key}}" data-bb-info-title="Movimiento {{label}}" data-bb-info="{{info}}"><span>{{label}}</span><small>{{#if (eq key "night")}}El peligro es peor de lo que imaginas{{else if (eq key "meddle")}}Busca una pista{{else if (eq key "occult")}}Un precio al otro lado del velo{{else}}Un riesgo a plena luz del día{{/if}}</small></button>{{/each}}</div>
          <div class="bb-section-title"><h2>Movimientos expertos</h2><span>{{expertMoves.length}} APRENDIDOS</span></div>
          <div class="bb-talent-grid">{{#each expertMoves}}<details class="bb-card" data-bb-info-title="{{name}}" data-bb-info="{{system.description}} {{useLabel}}."><summary><span>{{name}}</span><small>{{useLabel}}{{#if system.used}} · USADO{{/if}}</small></summary><p>{{system.description}}</p><p class="bb-source">{{system.source}}</p><div class="bb-actions"><button type="button" data-action="useMove" data-id="{{id}}" {{#if system.used}}disabled{{/if}}>Usar</button><button type="button" data-action="editMove" data-id="{{id}}">Abrir ficha</button></div></details>{{else}}<p>Añade un movimiento desde el compendio.</p>{{/each}}</div>
        </main>
        <aside>
          <h2>Condiciones · {{system.conditions.length}} / {{limits.conditions}}</h2>
          {{#each conditions}}<div class="bb-condition"><span>{{text}}</span>{{#unless permanent}}<button type="button" data-action="clear" data-index="{{index}}">Resolver</button>{{/unless}}</div>{{else}}<p class="bb-muted">De maravilla, gracias.</p>{{/each}}
          <button type="button" data-action="condition">{{#if conditionFull}}La cuarta exige una Corona{{else}}Añadir Condición{{/if}}</button>
          <p class="bb-note">Una Condición solo impone desventaja cuando afecta a la acción. La cuarta se sustituye por una Corona.</p>
          <h2>Escenas pendientes</h2>
          {{#each system.pending}}<article class="bb-card"><p>{{text}}</p><button type="button" data-action="done" data-id="{{id}}">{{#if (eq kind "crown")}}Marcar Corona{{else}}Escena narrada{{/if}}</button></article>{{else}}<p class="bb-muted">Ninguna pendiente.</p>{{/each}}
          <button type="button" data-action="crown">Ponerse una Corona</button>
        </aside>
      </div>
    {{/if}}

    {{#if life}}
      <div class="bb-two">
        <main>
          <div class="bb-section-title"><h2>Hogar, dulce hogar</h2><span>{{system.home.length}} / {{limits.home}}</span></div>
          <p>Marca un objeto para obtener ventaja. Permanece en casa, aunque normalmente no vuelve a dar ventaja hasta que se desmarque.</p>
          <div class="bb-slot-meter" aria-label="{{system.home.length}} de {{limits.home}} espacios ocupados">{{#each homeSlots}}<span class="{{#if filled}}filled{{/if}}" title="Espacio {{number}}"></span>{{/each}}</div>
          <button type="button" data-action="home" {{#if homeFull}}disabled{{/if}}>{{#if homeFull}}Los 18 espacios están ocupados{{else}}Añadir un objeto querido{{/if}}</button>
          <div class="bb-home-grid">{{#each system.home}}<article class="bb-card {{#if marked}}spent{{/if}}"><h3>{{name}}</h3><p>{{story}}</p><small>{{#if reusable}}Siempre disponible{{else if marked}}Ya evocado{{else}}Disponible para obtener ventaja{{/if}}</small><div class="bb-actions"><button type="button" data-action="editHome" data-id="{{id}}">Editar</button><button type="button" data-action="removeHome" data-id="{{id}}">Retirar</button></div></article>{{/each}}</div>
          <details class="bb-rules-fold"><summary>Reglas de Hogar</summary><p>Al empezar, cada jugadora puede proponer objetos. Después se añaden mediante movimientos o cuando lo indique la Guardiana.</p></details>
        </main>
        <aside>
          <h2>Experiencia · {{system.xp}} / {{limits.xp}}</h2>
          {{#if system.xpPending}}<p class="bb-note"><b>{{system.xpPending}} PE pendientes.</b> Se incorporan al elegir un avance.</p>{{/if}}
          <div class="bb-actions"><button type="button" data-action="advance" {{#unless xpFull}}disabled{{/unless}}>Elegir avance</button><button type="button" data-action="xp" {{#if xpFull}}disabled{{/if}}>+1 PE</button></div>
          <h3>Avances · {{system.advances.length}} / {{limits.advances}}</h3>{{#each advances}}<p class="bb-advance {{#if marked}}marked{{/if}}">{{#if marked}}✓{{else}}○{{/if}} {{text}}</p>{{/each}}
          <p class="bb-note">Cada avance cuesta 5 PE. Tras los cinco, ya no se obtienen más. Las habilidades no superan +3.</p>
          <h2>Fin de sesión</h2><p>Tres preguntas: la primera siempre está elegida y escoges otras dos.</p>
          <details class="bb-rules-fold"><summary>Ver mis preguntas</summary>{{#each questions}}<p>{{this}}</p>{{/each}}</details>
          <button type="button" data-action="questions">Cambiar las dos preguntas</button><button type="button" data-action="end">Estrellas, deseos y PE</button>
          <h2>Tu historia</h2><label>Estilo<input name="system.style" value="{{system.style}}"></label><label>Quehacer<input name="system.hobby" value="{{system.hobby}}"></label><label>Familia, carrera y recuerdos<textarea name="system.description" rows="5">{{system.description}}</textarea></label>
        </aside>
      </div>
    {{/if}}

    {{#if crowns}}
      <div class="bb-two"><main><span class="bb-eyebrow">TU VIDA, TUS RECUERDOS</span><h2>Corona de la Reina · {{system.queen.length}} / {{limits.queen}}</h2><p>Siete escenas en libre elección.</p>{{#each queen}}<p class="bb-card {{#if marked}}spent{{/if}}">{{#if marked}}✓{{else}}○{{/if}} {{text}}</p>{{/each}}<button type="button" data-action="crown">Elegir una Corona</button></main><aside class="bb-void"><span class="bb-eyebrow">EL MAR TAMBIÉN RECUERDA</span><h2>Corona del Vacío · {{system.void}} / {{limits.void}}</h2><p>Se marca en orden; la quinta retira a la Experta.</p>{{#each void}}<article class="bb-card"><h3>{{#if marked}}✓{{else}}○{{/if}} {{text}}</h3><p>{{detail}}</p></article>{{/each}}</aside></div>
    {{/if}}

    {{#if history}}
      <div class="bb-section-title"><h2>Las historias que contamos</h2><span>{{records.length}} TIRADAS</span></div><p>El dado original se conserva cuando una Corona cambia el nivel.</p>
      <div class="bb-history-grid">{{#each records}}<article class="bb-card"><div class="bb-row"><h3>{{label}}</h3><b>{{total}} · {{tierLabel}}</b></div><p>{{context}}</p>{{#if crowned}}<p>♛ Resultado revisado.</p>{{/if}}<div class="bb-actions">{{#if occultPending}}<button type="button" data-action="resolveOccult" data-id="{{id}}">Resolver Ocultista</button>{{/if}}{{#if canCrown}}<button type="button" data-action="crown" data-record="{{id}}">Usar Corona</button>{{/if}}<button type="button" data-action="recover" data-id="{{id}}">Mostrar en chat</button></div></article>{{else}}<p class="bb-empty">Tu próxima historia empieza con dos dados.</p>{{/each}}</div>
    {{/if}}
  </div>
</section>
