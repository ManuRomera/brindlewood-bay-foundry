<section class="bb-experta">
<header class="bb-masthead"><button type="button" class="bb-portrait-button" data-action="image" data-bb-info-title="Retrato de {{actor.name}}" data-bb-info="Pulsa para elegir o subir una imagen. También se utilizará en su token enlazado."><img class="bb-portrait" src="{{actor.img}}" alt="Retrato de {{actor.name}}"><span><i class="fas fa-camera"></i> Cambiar retrato</span></button><div><span class="bb-eyebrow">BRINDLEWOOD BAY · EXPERTAS DEL CRIMEN</span><input class="bb-name" name="name" aria-label="Nombre de la Experta" value="{{actor.name}}"><p>{{system.style}} · {{system.hobby}}</p></div><div class="bb-seal">☕<small>Una buena taza.<br>Un mal presagio.</small></div></header>
<div class="bb-stats">{{#each stats}}<div data-bb-info-title="{{label}}" data-bb-info="{{info}}"><label>{{label}}</label>{{#if ../unlocked}}<input type="number" name="system.stats.{{key}}" value="{{value}}" aria-label="{{label}}">{{else}}<button type="button" data-action="roll" data-move="meddle" data-stat="{{key}}" aria-label="Investigar con {{label}}">{{value}}</button>{{/if}}</div>{{/each}}</div>
<div class="bb-status"><span><b>{{system.xp}}</b> PE · {{system.advances.length}} / 5 avances</span><span>Reina {{system.queen.length}}/7 · Vacío {{system.void}}/5</span>{{#if system.retired}}<b>Experta retirada</b>{{/if}}{{#if editable}}<button type="button" data-action="lock">{{#if unlocked}}Bloquear habilidades{{else}}Editar habilidades{{/if}}</button>{{/if}}</div>
<nav class="bb-tabs" aria-label="Secciones de la ficha">{{#each tabs}}<button type="button" data-action="switchTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}" aria-pressed="{{active}}">{{label}}</button>{{/each}}</nav>
<div class="bb-scroll">
{{#if play}}<div class="bb-two"><main><h2>¿Qué hacemos, querida?</h2><p class="bb-muted">Cuéntalo por voz. Escribir un apunte para el chat es opcional.</p><div class="bb-move-grid">{{#each moves}}<button type="button" class="bb-move" data-action="roll" data-move="{{key}}" data-bb-info-title="Movimiento {{label}}" data-bb-info="{{info}}"><span>{{label}}</span><small>{{#if (eq key "night")}}El peligro es peor de lo que imaginas{{else if (eq key "meddle")}}Siempre hay algo que descubrir{{else if (eq key "occult")}}Un precio al otro lado del velo{{else}}Un riesgo a plena luz del día{{/if}}</small></button>{{/each}}</div><h2>Talentos de toda una vida</h2>{{#each expertMoves}}<details class="bb-card" data-bb-info-title="{{name}}" data-bb-info="{{system.description}}"><summary>{{name}}</summary><p>{{system.description}}</p><p class="bb-source">{{system.source}}</p><div class="bb-actions"><button type="button" data-action="useMove" data-id="{{id}}">Usar movimiento</button><button type="button" data-action="editMove" data-id="{{id}}">Abrir</button></div></details>{{else}}<p>Añade un movimiento desde el compendio o crea tu Experta en el salón del club.</p>{{/each}}</main><aside><h2>Cómo te encuentras</h2>{{#each conditions}}<div class="bb-condition"><span>{{text}}</span>{{#unless permanent}}<button type="button" data-action="clear" data-index="{{index}}" aria-label="Resolver {{text}}">Resolver</button>{{/unless}}</div>{{else}}<p class="bb-muted">De maravilla, gracias.</p>{{/each}}<button type="button" data-action="condition">Añadir Condición</button><p class="bb-note">La cuarta Condición se sustituye por una Corona. Afable permite eliminar una Condición tras compartir una escena íntima.</p><h2>Antes de despedirnos</h2>{{#each system.pending}}<article class="bb-card"><p>{{text}}</p><button type="button" data-action="done" data-id="{{id}}">{{#if (eq kind "crown")}}Marcar Corona pendiente{{else}}Escena narrada{{/if}}</button></article>{{else}}<p class="bb-muted">No hay escenas de Corona pendientes.</p>{{/each}}<button type="button" data-action="crown">Ponerse una Corona</button></aside></div>{{/if}}
{{#if life}}<div class="bb-two"><main><h2>Hogar, dulce hogar</h2><p>Objetos que cuentan quién eres. Al marcar uno obtienes ventaja; su historia permanece.</p><button type="button" data-action="home">Añadir un objeto querido</button><div class="bb-home-grid">{{#each system.home}}<article class="bb-card {{#if marked}}spent{{/if}}"><h3>{{name}}</h3><p>{{story}}</p><small>{{#if reusable}}Siempre disponible · Movimiento experto{{else if marked}}Ya evocado · Permanece en tu hogar{{else}}Disponible para obtener ventaja{{/if}}</small><button type="button" data-action="editHome" data-id="{{id}}">Contar su historia</button></article>{{/each}}</div><h2>Tu historia</h2><label>Estilo<input name="system.style" value="{{system.style}}"></label><label>Quehacer<input name="system.hobby" value="{{system.hobby}}"></label><label>Pareja, familia, carrera y recuerdos<textarea name="system.description" rows="6">{{system.description}}</textarea></label></main><aside><h2>Fin de sesión</h2>{{#each questions}}<p class="bb-card">{{this}}</p>{{/each}}<button type="button" data-action="questions">Cambiar mis dos preguntas</button><button type="button" data-action="end">Estrellas, deseos y PE</button><h2>Experiencia</h2><p>{{system.xp}} PE disponibles</p><button type="button" data-action="advance">Elegir un avance · 5 PE</button><button type="button" data-action="xp">PE de un movimiento</button>{{#each advances}}<p>{{#if marked}}✓{{else}}○{{/if}} {{text}}</p>{{/each}}</aside></div>{{/if}}
{{#if crowns}}<div class="bb-two"><main><span class="bb-eyebrow">TU VIDA, TUS RECUERDOS</span><h2>La Corona de la Reina</h2><p>Elige en cualquier orden. Narra la escena antes de acabar la sesión.</p>{{#each queen}}<p class="bb-card {{#if marked}}spent{{/if}}">{{#if marked}}✓{{else}}○{{/if}} {{text}}</p>{{/each}}<button type="button" data-action="crown">Elegir una Corona</button></main><aside class="bb-void"><span class="bb-eyebrow">EL MAR TAMBIÉN RECUERDA</span><h2>La Corona del Vacío</h2>{{#each void}}<article class="bb-card"><h3>{{#if marked}}✓{{else}}○{{/if}} {{text}}</h3><p>{{detail}}</p></article>{{/each}}</aside></div>{{/if}}
{{#if history}}<h2>Las historias que contamos</h2><p>El dado original se conserva cuando una Corona cambia el nivel del resultado.</p>{{#each records}}<article class="bb-card"><div class="bb-row"><h3>{{label}}</h3><b>{{total}} · {{tierLabel}}</b></div><p>{{context}}</p>{{#if crowned}}<p>♛ Resultado revisado mediante Corona.</p>{{/if}}<div class="bb-actions">{{#if occultPending}}<button type="button" data-action="resolveOccult" data-id="{{id}}">Resolver consecuencias ocultistas</button>{{/if}}{{#if canCrown}}<button type="button" data-action="crown" data-record="{{id}}">Reescribir con una Corona</button>{{/if}}<button type="button" data-action="recover" data-id="{{id}}">Mostrar en el chat</button></div></article>{{else}}<p class="bb-empty">Tu próxima historia empieza con dos dados.</p>{{/each}}{{/if}}
</div></section>
