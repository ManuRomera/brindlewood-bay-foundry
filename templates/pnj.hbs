<section class="bb-scroll">
  <header class="bb-masthead">
    <button type="button" class="bb-portrait-button" data-action="image" data-bb-info-title="Retrato de {{actor.name}}" data-bb-info="Pulsa para elegir o subir una imagen para este personaje."><img class="bb-portrait" src="{{actor.img}}" alt="Retrato de {{actor.name}}"><span><i class="fas fa-camera"></i> Cambiar retrato</span></button>
    <span class="bb-eyebrow">UN ROSTRO EN BRINDLEWOOD BAY</span>
  </header>
  <label>Nombre<input name="name" value="{{actor.name}}"></label>
  <label>Descripción, interpretación y cita<textarea name="system.description" rows="17">{{system.description}}</textarea></label>
  <p class="bb-source">{{system.source}}</p>
</section>
