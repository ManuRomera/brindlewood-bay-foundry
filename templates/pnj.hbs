<section class="bb-scroll bb-pnj">
  <header class="bb-cabecera bb-cabecera-caso">
    <button type="button" class="bb-retrato-boton" data-action="image" data-bb-info-title="Retrato" data-bb-info="Cambia la imagen y encuadra la zona que se ve de este personaje."><img class="bb-retrato" data-retrato="{{actor.id}}" src="{{actor.img}}" alt="Retrato de {{actor.name}}"><span><i class="fa-solid fa-crop-simple" aria-hidden="true"></i> Encuadrar</span></button>
    <div class="bb-identidad">
      <span class="bb-eyebrow">Un rostro en Brindlewood Bay</span>
      <input class="bb-nombre" name="name" aria-label="Nombre" value="{{actor.name}}">
      {{#if system.source}}<p class="bb-fuente">{{system.source}}</p>{{/if}}
    </div>
  </header>
  <div class="bb-cuerpo">
    <label>Descripción, interpretación y cita<textarea name="system.description" rows="16">{{system.description}}</textarea></label>
  </div>
</section>
