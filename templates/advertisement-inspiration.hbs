<div class="bb-ad-window">
  <div class="bb-dialog bb-ad bb-ad-seed">
    <div class="bb-ad-result">
      <p class="bb-eyebrow">SEMILLA PARA IMPROVISAR</p>
      <h3>{{product}}</h3>
      <p class="bb-ad-copy">{{text}}</p>
      <p class="bb-note">Léela como punto de partida: puedes cambiar cualquier detalle. Solo tú ves esta propuesta.</p>
    </div>
  </div>
  <footer class="form-footer">
    <button type="button" data-action="reroll"><i class="fa-solid fa-rotate"></i> Otra propuesta</button>
    <button type="button" data-action="close"><i class="fa-solid fa-check"></i> Cerrar</button>
  </footer>
</div>
