<section class="bb-scroll"><header class="bb-masthead"><span
      class="bb-eyebrow"
    >UN TALENTO DE TODA UNA VIDA</span></header><label>Nombre<input
      name="name"
      value="{{item.name}}"
    /></label><label>Movimiento<textarea
      name="system.description"
      rows="14"
    >{{system.description}}</textarea></label><label>Fuente<input
      name="system.source"
      value="{{system.source}}"
    /></label><p class="bb-note">Frecuencia:
    {{system.frequency}}
    ·
    {{#if system.used}}Uso gastado{{else}}Disponible{{/if}}</p></section>